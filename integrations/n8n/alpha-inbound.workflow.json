{
  "name": "ALPHA SALES OS — Inbound & STOP (réponses → mémoire → refill)",
  "meta": {
    "description": "Traite les emails entrants. Si la réponse ≈ STOP → marque le prospect désinscrit dans Google Sheets (unsubscribed=true, étape perdu) — à toi d'ajouter la suppression + l'ajout d'un remplaçant en aval. Sinon → POST vers l'app /api/webhooks/inbound (la réponse apparaît dans « Réponses entrantes » + brouillon IA). Variables d'env n8n : ALPHA_APP_URL, ALPHA_WEBHOOK_SECRET. Mappe Gmail + Google Sheets."
  },
  "nodes": [
    {
      "parameters": { "simple": true, "filters": {}, "options": {} },
      "id": "e0000000-0000-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [-320, 300],
      "credentials": { "gmailOAuth2": { "id": "REMPLACE_MOI", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "jsCode": "// Extrait l'expéditeur + le corps, détecte STOP.\nreturn items.map((it) => {\n  const j = it.json || {};\n  const from = (j.from || j.From || '').toString();\n  const email = (from.match(/[\\w.+-]+@[\\w.-]+/) || [''])[0].toLowerCase();\n  const name = from.replace(/<[^>]*>/, '').replace(/\"/g, '').trim();\n  const text = ((j.snippet || '') + ' ' + (j.subject || '') + ' ' + (j.text || '')).trim();\n  const isStop = /\\b(stop|désabonn|desabonn|unsubscribe|ne plus (me )?contacter)\\b/i.test(text);\n  return { json: { email, name, message: (j.snippet || j.text || '').slice(0, 2000), isStop } };\n});"
      },
      "id": "e0000000-0000-4000-8000-000000000002",
      "name": "Détecter STOP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ $json.isStop }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" }, "outputKey": "stop" }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "reply" }
      },
      "id": "e0000000-0000-4000-8000-000000000003",
      "name": "STOP ?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [140, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "value": "REMPLACE_PAR_TON_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CRM", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["email"],
          "value": {
            "email": "={{ $json.email }}",
            "unsubscribed": "true",
            "stage": "perdu",
            "history": "=[STOP reçu] désinscrit — à retirer + remplacer"
          }
        },
        "options": {}
      },
      "id": "e0000000-0000-4000-8000-000000000004",
      "name": "Sheets — marquer STOP",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [400, 160],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REMPLACE_MOI", "name": "Google Sheets account" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALPHA_APP_URL }}/api/webhooks/inbound",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-webhook-secret", "value": "={{ $env.ALPHA_WEBHOOK_SECRET }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"type\": \"email.reply\", \"email\": $json.email, \"name\": $json.name, \"message\": $json.message } }}",
        "options": {}
      },
      "id": "e0000000-0000-4000-8000-000000000005",
      "name": "App — réponse entrante",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 420]
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Détecter STOP", "type": "main", "index": 0 }]] },
    "Détecter STOP": { "main": [[{ "node": "STOP ?", "type": "main", "index": 0 }]] },
    "STOP ?": {
      "main": [
        [{ "node": "Sheets — marquer STOP", "type": "main", "index": 0 }],
        [{ "node": "App — réponse entrante", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
