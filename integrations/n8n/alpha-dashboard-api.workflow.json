{
  "name": "ALPHA SALES OS — API tableau de bord (webhook)",
  "meta": {
    "description": "Webhook n8n que l'app ALPHA SALES OS interroge (thin client). Contrat : POST { action } → 'ping' renvoie {ok:true} ; 'list' renvoie les lignes du CRM (Google Sheets) ; 'event' journalise. Autorise l'origine de ton app dans le nœud Webhook (Allowed Origins / CORS = *). Mappe ton Google Sheets + ta credential dans le nœud « CRM — lire les lignes »."
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alpha",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "aa000000-0000-4000-8000-000000000001",
      "name": "Webhook (App)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 300],
      "webhookId": "alpha-dashboard"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "rightValue": "list",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "list"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "loose" },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "rightValue": "event",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "event"
            }
          ]
        },
        "options": { "fallbackOutput": "extra", "renameFallbackOutput": "ping" }
      },
      "id": "aa000000-0000-4000-8000-000000000002",
      "name": "Router (action)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [-40, 300]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "REMPLACE_PAR_TON_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "CRM", "mode": "name" },
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000003",
      "name": "CRM — lire les lignes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 180],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REMPLACE_MOI", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000004",
      "name": "Répondre — rows",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true } }}",
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000005",
      "name": "Répondre — event ok",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [220, 360]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"service\": \"alpha-dashboard\" } }}",
        "options": {}
      },
      "id": "aa000000-0000-4000-8000-000000000006",
      "name": "Répondre — ping",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [220, 520]
    }
  ],
  "connections": {
    "Webhook (App)": {
      "main": [[{ "node": "Router (action)", "type": "main", "index": 0 }]]
    },
    "Router (action)": {
      "main": [
        [{ "node": "CRM — lire les lignes", "type": "main", "index": 0 }],
        [{ "node": "Répondre — event ok", "type": "main", "index": 0 }],
        [{ "node": "Répondre — ping", "type": "main", "index": 0 }]
      ]
    },
    "CRM — lire les lignes": {
      "main": [[{ "node": "Répondre — rows", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
