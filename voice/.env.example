# ── LiveKit ──
LIVEKIT_URL=wss://<ton-projet>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Marque (white-label) — l'accueil ENTRANT se déclare pour CE compte ──
# La divulgation art. 50 dira « pour le compte de <VOICE_BRAND_NAME> ».
VOICE_BRAND_NAME=EAGLEYE CORP
VOICE_BRAND_CITY=Lyon

# ── Téléphonie (appels sortants) ──
# Créer un trunk SIP sortant dans LiveKit, puis coller son ID ici.
SIP_OUTBOUND_TRUNK_ID=
#
# Appels ENTRANTS : rien à mettre ici. Ça se configure dans LiveKit
# (trunk entrant + Dispatch Rule → agent « alpha-voice »). L'agent sert alors
# l'accueil par défaut (DEFAULT_INBOUND_SCRIPT). Voir voice/GUIDE-APPELS.md §B.

# ── Modèle (LLM) — endpoint COMPATIBLE OpenAI, joignable côté serveur ──
# ⚠ Les 3 lignes (clé + modèle + base_url) doivent être COHÉRENTES entre elles.
#   C'est la cause n°1 du « LLM can't be fetched » : clé OpenAI sur base_url
#   NVIDIA, ou modèle NVIDIA sur base_url OpenAI (→ 404). L'agent journalise la
#   config au démarrage et alarme sur le mismatch.
#
# ⚠ Puter (js.puter.com) n'est PAS un LLM serveur : c'est un SDK NAVIGATEUR
#   (bouton « Écouter » du web). Il n'y a AUCUNE URL Puter à mettre ici.
#
# — Option A (défaut, GRATUIT) : NVIDIA NIM —
# ⚠ Le modèle NIM veut un id NAMESPACÉ « vendor/model » : « openai/gpt-oss-20b »,
#   PAS « gpt-oss-20b » seul (→ 404). Idem « meta/llama-3.3-70b-instruct ».
# ⚠ Pour la VOIX (temps réel), privilégie un modèle instruct RAPIDE. Les modèles
#   de raisonnement (gpt-oss) ajoutent de la latence et des blancs à l'oral —
#   llama-3.3-70b-instruct répond plus vif en conversation.
NVIDIA_API_KEY=
VOICE_MODEL=meta/llama-3.3-70b-instruct
VOICE_BASE_URL=https://integrate.api.nvidia.com/v1
#
# — Option B : OpenAI — (décommente et renseigne OPENAI_API_KEY plus bas)
# VOICE_MODEL=gpt-4o-mini
# VOICE_BASE_URL=https://api.openai.com/v1
#
# — Option C : Ollama local (aucune clé requise) —
# VOICE_MODEL=qwen2.5:7b
# VOICE_BASE_URL=http://localhost:11434/v1

# ── Voix (TTS) ──
# Option A (recommandée) : Fish Audio — voix multilingues, bon français.
#   Clé sur fish.audio. Choisis une voix française dans la bibliothèque,
#   copie son « reference id » dans FISH_VOICE_ID pour la meilleure
#   prononciation (sinon voix par défaut du plugin).
FISH_API_KEY=
FISH_VOICE_ID=
# Modèle : s2.1-pro est GRATUIT via l'API Fish (voir leur blog s2-1-pro-free-api).
FISH_MODEL=s2.1-pro
#
# Option B (GRATUIT, illimité) : Piper auto-hébergé — pour quand le crédit
# Fish est épuisé. Lance un serveur Piper et mets son URL ici (le plugin
# communautaire : pip install livekit-plugins-piper-tts).
PIPER_TTS_URL=
PIPER_VOICE=fr_FR-siwis-medium
#
# Option C (repli payant) : OpenAI TTS.
VOICE_TTS_VOICE=alloy
OPENAI_API_KEY=
#
# Forcer un fournisseur (sinon auto : fish → piper → openai) :
# VOICE_TTS_PROVIDER=fish   # fish | piper | openai

# ── Transcription ──
DEEPGRAM_API_KEY=
