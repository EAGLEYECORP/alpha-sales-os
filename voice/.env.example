# ── LiveKit ──
LIVEKIT_URL=wss://<ton-projet>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Marque (white-label) — l'accueil ENTRANT se déclare pour CE compte ──
# La divulgation art. 50 dira « pour le compte de <VOICE_BRAND_NAME> ».
VOICE_BRAND_NAME=EAGLEYE CORP
VOICE_BRAND_CITY=Lyon

# ── Téléphonie (appels sortants) ──
# Créer un trunk SIP sortant dans LiveKit, puis coller son ID ici.
SIP_OUTBOUND_TRUNK_ID=
#
# Appels ENTRANTS : rien à mettre ici. Ça se configure dans LiveKit
# (trunk entrant + Dispatch Rule → agent « alpha-voice »). L'agent sert alors
# l'accueil par défaut (DEFAULT_INBOUND_SCRIPT). Voir voice/GUIDE-APPELS.md §B.

# ── Modèle (LLM) — endpoint COMPATIBLE OpenAI, joignable côté serveur ──
# ⚠ Les 3 lignes (clé + modèle + base_url) doivent être COHÉRENTES entre elles.
#   C'est la cause n°1 du « LLM can't be fetched » : clé OpenAI sur base_url
#   NVIDIA, ou modèle NVIDIA sur base_url OpenAI (→ 404). L'agent journalise la
#   config au démarrage et alarme sur le mismatch.
#
# ⚠ Puter (js.puter.com) n'est PAS un LLM serveur : c'est un SDK NAVIGATEUR
#   (bouton « Écouter » du web). Il n'y a AUCUNE URL Puter à mettre ici.
#
# — Option A (défaut RECOMMANDÉ, GRATUIT) : NVIDIA NIM + openai/gpt-oss-20b —
#   Combo validé terrain : ce PETIT modèle répond SANS latence en conversation.
#   ⚠ Ne prends PAS le 70B ici : sur l'offre gratuite il fait la file d'attente
#     (~14 s/appel) → injouable en temps réel. Le petit gpt-oss-20b, lui, est vif.
#   ⚠ NVIDIA NIM veut un id NAMESPACÉ « vendor/model » : « openai/gpt-oss-20b »,
#     PAS « gpt-oss-20b » seul (→ 404). L'agent alarme si le namespace manque.
NVIDIA_API_KEY=
VOICE_MODEL=openai/gpt-oss-20b
VOICE_BASE_URL=https://integrate.api.nvidia.com/v1
#
# — Option A-bis (repli si besoin d'encore plus rapide) : Groq — gratuit —
#   Si un jour NVIDIA sature, Groq répond en <1 s. Clé sur console.groq.com :
# VOICE_BASE_URL=https://api.groq.com/openai/v1
# VOICE_MODEL=llama-3.1-8b-instant
# VOICE_API_KEY=gsk_...      # clé générique (prioritaire sur toutes les autres)
#
# — Option B : OpenAI — (décommente et renseigne OPENAI_API_KEY plus bas)
# VOICE_MODEL=gpt-4o-mini
# VOICE_BASE_URL=https://api.openai.com/v1
#
# — Option C : Ollama local (aucune clé requise) —
# VOICE_MODEL=qwen2.5:7b
# VOICE_BASE_URL=http://localhost:11434/v1

# ── Voix (TTS) ──
# Option A (recommandée) : Fish Audio — voix multilingues, bon français.
#   Clé sur fish.audio. Choisis une voix française dans la bibliothèque,
#   copie son « reference id » dans FISH_VOICE_ID pour la meilleure
#   prononciation (sinon voix par défaut du plugin).
FISH_API_KEY=
FISH_VOICE_ID=
# Modèle : s2.1-pro est GRATUIT via l'API Fish (voir leur blog s2-1-pro-free-api).
FISH_MODEL=s2.1-pro
#
# Option B (GRATUIT, illimité) : Piper auto-hébergé — pour quand le crédit
# Fish est épuisé. Serveur :
#   python3 -m piper.http_server -m fr_FR-siwis-medium --host 127.0.0.1 --port 5000
# ⚠ L'URL DOIT finir par /synthesize : le plugin poste {"text":…} là, et
#   piper.http_server ne sert la synthèse QUE sur /synthesize (POST / = 405).
PIPER_TTS_URL=http://127.0.0.1:5000/synthesize
PIPER_VOICE=fr_FR-siwis-medium
#
# Option C (repli payant) : OpenAI TTS.
VOICE_TTS_VOICE=alloy
OPENAI_API_KEY=
#
# Forcer un fournisseur (sinon auto : fish → piper → openai) :
# VOICE_TTS_PROVIDER=fish   # fish | piper | openai

# ── Transcription ──
DEEPGRAM_API_KEY=

# ── Journal de session → ALPHA SALES (sessions visibles + transcription) ──
# L'agent pousse start / chaque tour de parole / end vers cette route. La
# transcription vient de Deepgram (déjà payée pour le STT) : l'historique de
# conversation ne coûte donc rien de plus.
# Vide = désactivé (l'agent tourne normalement, sans journal).
ALPHA_SESSION_URL=https://<ton-app>/api/voice/session
# Secret partagé — DOIT être identique à VOICE_WEBHOOK_SECRET côté app
# (.env.local / Vercel). En production, la route REFUSE tout appel non signé :
# sans ce secret, les appels se déroulent normalement mais les transcriptions
# sont perdues en silence. L'agent le crie au démarrage si tu l'oublies.
# Un journal d'appels ouvert au monde serait une fuite de données personnelles.
VOICE_WEBHOOK_SECRET=
