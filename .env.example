# ── Supabase (optional — app runs 100% local without it) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI (optional — falls back to Hormozi template engine without it) ──
# Option 1 (recommandé, 100 % local, gratuit) : Ollama.
#   ollama pull qwen2.5:3b   puis renseigne :
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Option 2 : Anthropic Claude (cloud). Ollama est prioritaire si OLLAMA_MODEL est défini.
# NVIDIA NIM — GRATUIT, 100+ modèles, clé sur build.nvidia.com (nvapi-…)
# Cascade : Ollama (local) → NVIDIA → Anthropic → templates
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ── Envoi réel (open-source, zéro vendor lock-in) ────────────────────
# Email : Nodemailer sur n'importe quel SMTP (Gmail app-password, OVH,
# Brevo, Mailgun, ton propre Postfix…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Brouillons Gmail HTML (Boîte d'envoi → « Créer les brouillons HTML »).
# Dépose un vrai brouillon HTML, prêt à envoyer, via IMAP APPEND. Le MÊME
# mot de passe d'application Gmail que SMTP ci-dessus suffit : par défaut
# IMAP réutilise SMTP_USER / SMTP_PASS. Ne renseigner ci-dessous que pour
# une boîte différente ou un fournisseur non-Gmail.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Dossier des brouillons si la découverte automatique échoue (rare).
IMAP_DRAFTS_MAILBOX=

# SMS : API compatible Textbelt (open-source, auto-hébergeable —
# https://github.com/typpo/textbelt). Laisser TEXTBELT_URL vide pour
# le service hébergé textbelt.com.
TEXTBELT_URL=
TEXTBELT_KEY=

# Récap urgent (Aujourd'hui → « M'envoyer le récap », et cron n8n du matin).
# Destinataire FIXE (jamais fourni par la requête) : ton mobile pour le SMS,
# ton email pour le repli. Canal auto : SMS si TEXTBELT_KEY, sinon email.
ALERT_PHONE=
DIGEST_EMAIL=

# Nom affiché en signature des emails (closer / agence)
CLOSER_NAME=EAGLEYE

# Transcription vocale SERVEUR — pour que le Débrief marche sur TOUS les
# navigateurs (Chromium, Brave, Firefox…), pas seulement Chrome/Edge/Safari.
# Option 1 : Deepgram (REST simple, palier gratuit) → deepgram.com
DEEPGRAM_API_KEY=
# Option 2 : Whisper compatible OpenAI (OpenAI, Groq, NVIDIA, local…)
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ── Tracking & délivrabilité (ne PAS finir dans les spams) ───────────
# URL PUBLIQUE de l'app (obligatoire pour le tracking : les clients mail
# chargent le pixel et les liens à distance). Ex. https://os.eagleye.fr
# Laisser vide en dev → l'origine de la requête est utilisée.
TRACKING_BASE_URL=
APP_BASE_URL=

# Désinscription = réponse « STOP » (traitée par n8n via le webhook entrant).
# L'en-tête List-Unsubscribe pointe automatiquement en mailto sur SMTP_FROM.

# Anti-pic : nombre max d'emails envoyés par heure (protège la réputation).
# Durable via Supabase (compté sur tracking_messages) si le service role est
# configuré, sinon en mémoire (mono-instance).
MAX_SENDS_PER_HOUR=40

# Dédup « déjà contacté » : ne pas recontacter un email avant N jours
# (0 pour désactiver). Durable via Supabase.
CONTACT_COOLDOWN_DAYS=14

# Optionnel : chaque ouverture/clic est POSTée ici (webhook n8n).
# ⚠ Elle part de l'instance qui ENREGISTRE l'ouverture — sur Vercel, ce
# serait Vercel → il ne peut pas joindre un n8n local : LAISSE VIDE dans
# ce cas et importe plutôt alpha-tracking-sync.workflow.json (n8n TIRE
# les compteurs depuis Supabase → Sheets, aucune exposition réseau).
# Ne la remplis que si ton n8n a une URL https publique.
TRACKING_WEBHOOK_URL=

# ── Porte d'accès (OBLIGATOIRE en déploiement public : Vercel) ───────
# Si définie, l'app exige ce mot de passe avant de servir la moindre page.
# Le pixel de tracking, les webhooks entrants et /api/health restent
# publics (indispensable au fonctionnement). Laisse VIDE en local.
SITE_PASSWORD=

# ── Webhooks entrants (réponses email/WhatsApp/formulaires) ──────────
# Secret partagé exigé sur POST /api/webhooks/inbound.
# DOIT être identique à ALPHA_WEBHOOK_SECRET côté n8n (workflow alpha-inbound).
# En local : app sur http://localhost:3000, n8n sur http://localhost:5678.
WEBHOOK_SECRET=

# En prod serverless (Vercel), les événements webhook sont stockés dans
# Supabase (table inbound_events) — nécessite la clé service role :
SUPABASE_SERVICE_ROLE_KEY=

# ── ALPHA VOICE (agent vocal — optionnel) ──
# Sans ces clés, /voice reste utile : il montre ce que dirait l'agent.
# Installation complète : voice/README.md

# Secret partagé avec l'agent Python (voice/.env → VOICE_WEBHOOK_SECRET).
# OBLIGATOIRE en production : sans lui, /api/voice/session refuse TOUT, agent
# compris. C'est volontaire — ce journal contient les transcriptions d'appels,
# donc des données personnelles. Il ne s'ouvre pas par défaut.
VOICE_WEBHOOK_SECRET=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── API publique v1 (ingestion n8n / CRM tiers) ──────────────────────
# Liste de clés séparées par des virgules, exigées sur /api/v1/prospects.
# VIDE = la route est FERMÉE. Une API d'écriture ouverte par défaut est une
# faute, pas une commodité.
ALPHA_API_KEYS=

# ── Autopilote de campagne (cron) ────────────────────────────────────
# Secret exigé sur POST /api/campaign/tick. VIDE = la route refuse de tourner.
# Cette route passe de VRAIS appels téléphoniques : elle ne s'ouvre jamais
# au monde, et le cron doit l'envoyer en « Authorization: Bearer … ».
CRON_SECRET=

# Second geste, délibéré : sans « on », l'autopilote s'exécute en SIMULATION
# et rend ce qu'il AURAIT fait. Déployer ne suffit donc pas à déclencher un
# appel.
CAMPAIGN_AUTOPILOT=

# ── NOTIFICATIONS HORS-APP (Web Push) ────────────────────────────────
# Génère les deux clés UNE fois — la commande est dans docs/NOTIFICATIONS.md.
# La publique part dans le navigateur (c'est son rôle) ; la privée ne quitte
# jamais le serveur. VIDE = les notifications sont désactivées, et l'écran
# de réglages le dit au lieu de laisser croire qu'elles marchent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@eagleyecorp.fr
