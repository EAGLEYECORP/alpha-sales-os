# ── Supabase (optional — app runs 100% local without it) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI (optional — falls back to Hormozi template engine without it) ──
# Option 1 (recommandé, 100 % local, gratuit) : Ollama.
#   ollama pull qwen2.5:3b   puis renseigne :
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Option 2 : Anthropic Claude (cloud). Ollama est prioritaire si OLLAMA_MODEL est défini.
# NVIDIA NIM — GRATUIT, 100+ modèles, clé sur build.nvidia.com (nvapi-…)
# Cascade : Ollama (local) → NVIDIA → Anthropic → templates
NVIDIA_API_KEY=
# ⚠ Un identifiant de modèle EXPIRE. meta/llama-3.3-70b-instruct est mort le
#   26/08/2026 (410 Gone) et a fait tomber l'agent vocal ET toute l'IA de l'app.
#   Laisse vide pour prendre le défaut du code (lib/modeles.ts), qui est tenu à jour.
NVIDIA_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ── BYOK : les clés apportées par les locataires ──────────────────────
# Clé maître qui CHIFFRE les identifiants que les locataires collent dans
# leurs Réglages (table tenant_credentials, migration 010). 32 octets, en
# hex (64 caractères) ou en base64. Pour en générer une :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# ⚠ ABSENTE = aucune clé de locataire ne peut être ni enregistrée ni relue.
# Il n'y a AUCUN repli : une clé par défaut écrite dans le dépôt donnerait
# un chiffrement qui a l'air fait et ne protège rien. Mieux vaut refuser
# d'enregistrer que stocker le secret d'un client en clair déguisé.
#
# ⚠ La changer rend ILLISIBLES toutes les clés déjà enregistrées — les
# locataires devront recoller les leurs. C'est à ça que sert `cle_version`
# en base : permettre une rotation progressive le jour où on en aura besoin.
CREDENTIALS_MASTER_KEY=

# ── Envoi réel (open-source, zéro vendor lock-in) ────────────────────
# Email : Nodemailer sur n'importe quel SMTP (Gmail app-password, OVH,
# Brevo, Mailgun, ton propre Postfix…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Brouillons Gmail HTML (Boîte d'envoi → « Créer les brouillons HTML »).
# Dépose un vrai brouillon HTML, prêt à envoyer, via IMAP APPEND. Le MÊME
# mot de passe d'application Gmail que SMTP ci-dessus suffit : par défaut
# IMAP réutilise SMTP_USER / SMTP_PASS. Ne renseigner ci-dessous que pour
# une boîte différente ou un fournisseur non-Gmail.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Dossier des brouillons si la découverte automatique échoue (rare).
IMAP_DRAFTS_MAILBOX=

# SMS : API compatible Textbelt (open-source, auto-hébergeable —
# https://github.com/typpo/textbelt). Laisser TEXTBELT_URL vide pour
# le service hébergé textbelt.com.
TEXTBELT_URL=
TEXTBELT_KEY=

# Récap urgent (Aujourd'hui → « M'envoyer le récap », et cron n8n du matin).
# Destinataire FIXE (jamais fourni par la requête) : ton mobile pour le SMS,
# ton email pour le repli. Canal auto : SMS si TEXTBELT_KEY, sinon email.
ALERT_PHONE=
DIGEST_EMAIL=

# (CLOSER_NAME a été RETIRÉ.) La signature ne vient plus d'une variable
# d'environnement : une seule valeur ne peut pas signer les envois de
# plusieurs comptes. Elle se règle dans l'app — Réglages → Agence — et le
# serveur l'arbitre (lib/expediteur.ts → habillageEnvoi).

# Transcription vocale SERVEUR — pour que le Débrief marche sur TOUS les
# navigateurs (Chromium, Brave, Firefox…), pas seulement Chrome/Edge/Safari.
# Option 1 : Deepgram (REST simple, palier gratuit) → deepgram.com
DEEPGRAM_API_KEY=
# Option 2 : Whisper compatible OpenAI (OpenAI, Groq, NVIDIA, local…)
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ── Tracking & délivrabilité (ne PAS finir dans les spams) ───────────
# URL PUBLIQUE de l'app (obligatoire pour le tracking : les clients mail
# chargent le pixel et les liens à distance). Ex. https://os.eagleye.fr
# Laisser vide en dev → l'origine de la requête est utilisée.
TRACKING_BASE_URL=
APP_BASE_URL=

# Désinscription = réponse « STOP » (traitée par n8n via le webhook entrant).
# L'en-tête List-Unsubscribe pointe automatiquement en mailto sur SMTP_FROM.

# Anti-pic : nombre max d'emails envoyés par heure (protège la réputation).
# Durable via Supabase (compté sur tracking_messages) si le service role est
# configuré, sinon en mémoire (mono-instance).
MAX_SENDS_PER_HOUR=40

# Dédup « déjà contacté » : ne pas recontacter un email avant N jours
# (0 pour désactiver). Durable via Supabase.
CONTACT_COOLDOWN_DAYS=14

# Optionnel : chaque ouverture/clic est POSTée ici (webhook n8n).
# ⚠ Elle part de l'instance qui ENREGISTRE l'ouverture — sur Vercel, ce
# serait Vercel → il ne peut pas joindre un n8n local : LAISSE VIDE dans
# ce cas et importe plutôt alpha-tracking-sync.workflow.json (n8n TIRE
# les compteurs depuis Supabase → Sheets, aucune exposition réseau).
# Ne la remplis que si ton n8n a une URL https publique.
TRACKING_WEBHOOK_URL=

# ── Porte d'accès (OBLIGATOIRE en déploiement public : Vercel) ───────
# Si définie, l'app exige ce mot de passe avant de servir la moindre page.
# Le pixel de tracking, les webhooks entrants et /api/health restent
# publics (indispensable au fonctionnement). Laisse VIDE en local.
SITE_PASSWORD=

# ── Webhooks entrants (réponses email/WhatsApp/formulaires) ──────────
# Secret partagé exigé sur POST /api/webhooks/inbound.
# DOIT être identique à ALPHA_WEBHOOK_SECRET côté n8n (workflow alpha-inbound).
# En local : app sur http://localhost:3000, n8n sur http://localhost:5678.
WEBHOOK_SECRET=

# En prod serverless (Vercel), les événements webhook sont stockés dans
# Supabase (table inbound_events) — nécessite la clé service role :
SUPABASE_SERVICE_ROLE_KEY=

# ── LES DEUX VARIABLES QUI LÈVENT LE MUR ────────────────────────────
#
# ⚠ Depuis que SITE_PASSWORD ne garde plus que les surfaces d'administration
# (/payouts, /offre, /api/sync), c'est ce couple-là qui protège tout le reste.
# Le middleware ne lève le mot de passe QUE si les comptes sont actifs ET que
# le JWT est réellement exigé côté serveur. Les deux sont opt-in : tant qu'ils
# ne sont pas posés, l'application entière reste derrière SITE_PASSWORD.
#
# C'est volontaire, et c'est le sens sûr : sans autre serrure, lever le mur
# rendrait publiques des routes qui envoient de vrais emails (/api/send) et
# composent de vrais numéros (/api/voice/call).
#
# REQUIRE_AUTH=1 exige une session Supabase valide sur les API de données.
REQUIRE_AUTH=
# Le secret de vérification du JWT (Supabase → Settings → API → JWT Secret).
# ⚠ REQUIRE_AUTH posé SANS ce secret = refus systématique (503, fail-closed).
SUPABASE_JWT_SECRET=

# ── ALPHA VOICE (agent vocal — optionnel) ──
# Sans ces clés, /voice reste utile : il montre ce que dirait l'agent.
# Installation complète : voice/README.md

# Secret partagé avec l'agent Python (voice/.env → VOICE_WEBHOOK_SECRET).
# OBLIGATOIRE en production : sans lui, /api/voice/session refuse TOUT, agent
# compris. C'est volontaire — ce journal contient les transcriptions d'appels,
# donc des données personnelles. Il ne s'ouvre pas par défaut.
VOICE_WEBHOOK_SECRET=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── API publique v1 (ingestion n8n / CRM tiers) ──────────────────────
# Liste de clés séparées par des virgules, exigées sur /api/v1/prospects.
# VIDE = la route est FERMÉE. Une API d'écriture ouverte par défaut est une
# faute, pas une commodité.
ALPHA_API_KEYS=

# ── Autopilote de campagne (cron) ────────────────────────────────────
# Secret exigé sur POST /api/campaign/tick. VIDE = la route refuse de tourner.
# Cette route passe de VRAIS appels téléphoniques : elle ne s'ouvre jamais
# au monde, et le cron doit l'envoyer en « Authorization: Bearer … ».
CRON_SECRET=

# Second geste, délibéré : sans « on », l'autopilote s'exécute en SIMULATION
# et rend ce qu'il AURAIT fait. Déployer ne suffit donc pas à déclencher un
# appel.
CAMPAIGN_AUTOPILOT=

# Palier de montée en charge de l'autopilote (lib/paliers-campagne.ts).
# Plafond CUMULÉ d'appels composés, tous jours confondus : 10, 100, 1000, ou
# « aucun » pour lever le bornage. NON DÉFINIE = le palier le plus bas (10).
#
# ⚠ Il ne se lit PAS dans les réglages du navigateur, et c'est voulu : valider
# un palier dans l'app ne débride pas le cron. Deux gestes, comme pour
# CAMPAIGN_AUTOPILOT — parce qu'une variable mal orthographiée ne doit jamais
# ouvrir les vannes sur 1 000 vraies personnes.
CAMPAIGN_PALIER=

# ── NOTIFICATIONS HORS-APP (Web Push) ────────────────────────────────
# Génère les deux clés UNE fois — la commande est dans docs/NOTIFICATIONS.md.
# La publique part dans le navigateur (c'est son rôle) ; la privée ne quitte
# jamais le serveur. VIDE = les notifications sont désactivées, et l'écran
# de réglages le dit au lieu de laisser croire qu'elles marchent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@eagleyecorp.fr

# ── FLUX CALENDRIER (abonnement iCal) ────────────────────────────────
# Jeton porté dans l'URL du flux : un client de calendrier n'envoie ni
# cookie ni en-tête, l'authentification ne peut être QUE là. Qui a l'URL a
# les rendez-vous — elle se traite comme un mot de passe, et se change en
# modifiant cette valeur. VIDE = flux fermé.
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CALENDAR_TOKEN=

# ── NOTION (envoi du pipeline, sens unique) ──────────────────────────
# Intégration INTERNE Notion (notion.so/my-integrations) : un jeton secret,
# pas d'OAuth. Le jeton reste côté serveur — une intégration Notion peut lire
# et écrire tout ce à quoi elle a accès. Partage la base avec l'intégration,
# sinon elle ne la voit pas. VIDE = envoi désactivé.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────────
# QUATRE VARIABLES QUI EXISTAIENT DANS LE CODE ET NULLE PART AILLEURS.
#
# Toutes optionnelles : l'app tourne sans. Mais une variable qu'on ne
# découvre qu'en lisant le code est une variable qu'on ne pose jamais — et
# le comportement par défaut, on le subit sans savoir qu'il existe.
# ─────────────────────────────────────────────────────────────────────

# URL publique de l'app, utilisée pour fabriquer les liens ABSOLUS (flux iCal,
# liens de tracking et de désinscription). VIDE = l'origine de la requête est
# utilisée, ce qui marche partout SAUF quand un lien doit survivre hors du
# navigateur : un .ics importé dans un agenda ne peut pas deviner l'origine.
NEXT_PUBLIC_APP_URL=

# Point d'entrée de l'API NVIDIA. À changer seulement pour viser un NIM
# auto-hébergé. VIDE = https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

# ── LECTURE DU SITE D'UN PROSPECT, pour l'audit ──
#
# ⚠ Ce n'est PAS un scraper d'annuaire : c'est la lecture de la page publique
# de l'entreprise qu'on est en train d'auditer, protégée par un garde
# anti-SSRF (`lib/site-fetch.ts`). Le sourcing, lui, reste dehors — voir
# docs/SOURCING.md.
#
# VIDE = `fetch()` direct côté serveur, ce qui suffit pour la grande majorité
# des sites de TPE. Un endpoint n'est utile que pour les sites rendus en JS ou
# protégés par un anti-bot, qui exigent un vrai navigateur.
SCRAPE_ENDPOINT=
SCRAPE_KEY=

# ── FACTURATION STRIPE — ce qui permet d'encaisser ──
#
# ⚠ AUCUNE de ces variables n'était documentée ici, alors que `lib/stripe.ts`
# en dépend depuis le début. Conséquence en production : le bouton « payer »
# renvoyait une erreur 503, ou pire, un lien de prix vide. Un test
# (`tests/offres-publiques.test.ts`) vérifie désormais que TOUTE offre affichée
# a sa variable déclarée ici — une variable oubliée est une vente perdue au
# moment exact où le client voulait payer.
#
# Clé secrète du compte Stripe (sk_live_… en production, sk_test_… avant).
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), pour /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
#
# Un ID de prix (price_…) par offre de la grille publique
# (`lib/offres-publiques.ts`). Ils se créent dans le tableau de bord Stripe.
#
#   ESSAI     — paiement UNIQUE, 290 € HT. Pas un abonnement : c'est une mise
#               en route, déduite du premier mois si le client bascule.
#   SOLO/PRO  — abonnements mensuels, 79 € et 149 € HT.
#   VOIX_1000 — abonnement mensuel du palier de campagne, 364 € HT.
#   BUSINESS  — installation 10 000 € HT ÉTALÉE : 2 500 € à la signature puis
#               10 × 800 €, PUIS 1 000 € HT/mois d'abonnement. Deux prix
#               Stripe sont donc nécessaires côté tableau de bord (la
#               mensualité d'étalement, puis l'abonnement) ; cette variable
#               porte celui par lequel la souscription DÉMARRE.
#               ⚠ L'étalement doit s'ARRÊTER après 10 prélèvements. Un
#               abonnement Stripe sans date de fin continuerait à prélever
#               800 € indéfiniment, en plus de l'abonnement qui prend le
#               relais — le client paierait deux fois, tous les mois.
#   LIFETIME  — paiement UNIQUE. Le créer en récurrent facturerait tous les
#               mois quelqu'un à qui on vient de promettre « payé une fois ».
# ⚠ ESSAI / SOLO / PRO ont été RETIRÉS de la grille le 04/09/2026 : « solo »
#   facturait un périmètre devenu gratuit, « pro » chevauchait Alpha Voice au
#   même prix, et l'essai payant faisait double emploi avec la garantie
#   (« l'installation ne se paie qu'au premier rendez-vous »). Leurs prix
#   Stripe sont à ARCHIVER dans le tableau de bord — les retirer d'ici les
#   rend inatteignables depuis l'app, ça n'annule aucun abonnement en cours.
STRIPE_PRICE_VOIX_ESSENTIEL=
STRIPE_PRICE_VOIX_INTENSIF=
STRIPE_PRICE_OMNICANAL=
STRIPE_PRICE_VOIX_1000=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_LIFETIME=
#
# ── LE COMPTE PROPRIÉTAIRE — DEUX variables, et elles doivent CONCORDER ──
#
# Formes acceptées : l'adresse exacte, ou `@domaine.fr` pour tout un domaine.
# Séparées par des virgules. Une entrée vide ne matche personne.
#
# ⚠ SANS `OWNER_EMAILS`, PERSONNE N'EST MAÎTRE — toi compris. Tu te verrais
# refuser tes propres routes : /payouts, /offre, et surtout les routes qui
# servent notre patrimoine (/api/pipeline, /api/voice-costs, /api/knowledge,
# /api/references) répondent alors 403 à tout le monde. C'est fail-safe dans
# le bon sens, mais ça se pose AVANT de basculer en production.
#
# ⚠ LES DEUX DOIVENT PORTER LA MÊME LISTE. `OWNER_EMAILS` est lu par le
# SERVEUR (lib/entitlements.ts → la barrière du middleware) ;
# `NEXT_PUBLIC_OWNER_EMAILS` est lu par le NAVIGATEUR (lib/billing.ts → ce
# que l'écran affiche). Si elles divergent, l'écran dit une chose et le
# serveur en fait une autre — le pire ticket de support qui soit, parce
# qu'il n'est reproductible que chez la personne concernée.
#
# `NEXT_PUBLIC_` est PUBLIC par construction : il part dans le bundle du
# navigateur. N'y mets qu'une adresse que tu assumes de voir lue par
# n'importe qui — l'adresse de contact de la société, pas une boîte perso.
#
# La valeur RÉELLE pour ce déploiement, les deux lignes identiques :
#   OWNER_EMAILS=contact@eagleyecorp.fr,eagleyecorp.ad@gmail.com
#
# ⚠ Les deux adresses, pas une. `contact@` est l'adresse de la société ;
# `eagleyecorp.ad@gmail.com` est celle par laquelle le compte a été ouvert.
# N'en poser qu'une revient à se verrouiller dehors le jour où on se connecte
# avec l'autre — et le symptôme est un 403 sur ses propres routes, ce qui
# ressemble à une panne plutôt qu'à une config.
OWNER_EMAILS=
NEXT_PUBLIC_OWNER_EMAILS=
# Mettre à 1 pour EXIGER un abonnement actif sur les actions payantes.
REQUIRE_SUBSCRIPTION=

# ── GÉNÉRATION VIDÉO (studio contenu — entièrement optionnel) ────────
# Sans aucune de ces variables, /social reste utile : il rédige les posts et
# le script, il ne rend simplement pas la vidéo. Rien ne casse.
#
# Voie 1 — json2video : rendu par gabarit (scènes, textes, voix, images
# décrits en JSON). C'est la voie qui marche sans GPU, et elle suffit.
JSON2VIDEO_API_KEY=
#
# Voie 2 — text-to-video générique. ⚠ HunyuanVideo & co sont des MODÈLES, pas
# des API : ils exigent un gros GPU et ne tournent pas dans l'app Next. Ces
# deux variables ne sont qu'un CONNECTEUR : si tu héberges un endpoint (ou
# utilises Replicate/fal), Alpha l'appelle. Sinon, laisse vide.
VIDEO_GEN_ENDPOINT=
VIDEO_GEN_KEY=

# ══ L'AGENT VOCAL — CES SEIZE-LÀ NE VONT PAS SUR VERCEL ═══════════════
#
# ⚠⚠ ELLES ÉTAIENT LUES PAR `voice/agent.py` ET DOCUMENTÉES NULLE PART
# (trouvé le 13/09/2026). `tests/env-documente.test.ts` ne scannait que le
# TypeScript : seize variables — dont la clé Fish, celle qu'il faut faire
# tourner — n'apparaissaient dans aucun fichier de référence. Quelqu'un qui
# monte l'agent les découvrait une par une, au premier plantage de chacune.
#
# ⚠ OÙ ELLES VONT, et s'y tromper coûte une heure : l'agent vocal tourne EN
# LOCAL (décision du 09/09/2026), pas sur Vercel. Ces variables vivent dans
# l'environnement de la MACHINE qui lance `voice/agent.py`. Les coller dans
# Vercel ne casse rien et ne sert à rien — aucune route ne les lit.

# Le battement de présence. Sans lui, l'autopilote REFUSE de composer — c'est
# voulu : un appel sans agent vivant sonne dans le vide et brûle la fiche.
# ⚠ `CRON_SECRET` doit être IDENTIQUE à celui de Vercel et du Vault Supabase.
ALPHA_APP_URL=
ALPHA_SESSION_URL=

# Voix (Fish Audio par défaut). ⚠ Une clé Fish a été exposée en clair : la
# faire tourner avant toute mise en service.
FISH_API_KEY=
FISH_MODEL=
FISH_VOICE_ID=
# Replis TTS, tous optionnels.
VOICE_TTS_PROVIDER=
VOICE_TTS_VOICE=
PIPER_TTS_URL=

# Le modèle qui parle. NVIDIA NIM `openai/gpt-oss-20b` par défaut — ne PAS
# repasser au 70B : il fait la file d'attente ~14 s.
VOICE_MODEL=
VOICE_BASE_URL=
VOICE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Ce que l'agent PRONONCE — art. 50 EU AI Act : la première phrase dit qu'il
# est une IA et pour le compte de QUI. Ces deux valeurs y entrent.
VOICE_BRAND_NAME=
VOICE_BRAND_CITY=

# Le trunk SIP sortant (LiveKit ↔ Telnyx).
SIP_OUTBOUND_TRUNK_ID=

# ── Pont Telegram (dire à Alpha quoi faire depuis le téléphone) ──
# Optionnel. Sans TELEGRAM_WEBHOOK_SECRET, la route /api/telegram répond 404
# (fail-closed). Détail : docs/TELEGRAM.md.
# Token du bot (@BotFather). SECRET.
TELEGRAM_BOT_TOKEN=
# Secret d'en-tête posé au setWebhook, comparé à temps constant. SECRET.
TELEGRAM_WEBHOOK_SECRET=
# L'id numérique du SEUL expéditeur autorisé (toi). Sans lui, personne n'est
# autorisé (fail-closed).
TELEGRAM_OWNER_CHAT_ID=

# ── Jev (TypeSafe AI) — moteur de DÉCISION TYPÉE, optionnel ──────────────
# Jev tranche un classement (l'intention d'une réponse, un intent) au lieu de
# rédiger. Le joint `lib/decision-typee.ts` le prend s'il est configuré, sinon
# il reste sur le LLM. Les DEUX variables, sinon `jevDisponible()` = false
# (fail-closed) et personne ne passe par Jev. Voir `lib/jev.ts` : le client est
# un joint DÉCLARÉ, à remplir quand la doc + la clé existent.
JEV_URL=
# SECRET.
JEV_API_KEY=
